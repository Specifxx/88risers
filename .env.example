# Postgres connection string. On Vercel: Storage → Create Database → Neon (Postgres)
# sets this automatically. Supabase / Railway / any Postgres URL also works.
# Leave unset for local development — a file-based PGlite database in ./.data is used.
DATABASE_URL=

# The secret that makes up your admin link: https://<your-site>/admin/<ADMIN_KEY>
# Generate one with:  openssl rand -base64 24 | tr -d '/+=' 
# Locally it defaults to "dev-admin" → http://localhost:3000/admin/dev-admin
ADMIN_KEY=

# Public URL, used for sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://88-risers.vercel.app

# Optional: email the club when someone registers interest in a shop product.
# Use the club Gmail and a Google app password (Google Account → Security →
# 2-Step Verification → App passwords). Without these, interest is still saved
# and listed in the admin Shop tab, just not emailed.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where those emails go (defaults to the club email in lib/site.ts).
MAIL_TO=
